{
  "id": "base-alert",
  "title": "Base Alert",
  "component": "BaseAlert",
  "family": "base",
  "license": "MIT",
  "files": ["BaseAlert.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme", "base-button"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "alert"],
  "expoSdk": 58,
  "dependencies": {
    "lucide-react-native": "^1.61.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-alert-dismiss"
    },
    "target": {
      "testID": "base-alert-dismiss"
    },
    "effect": {
      "before": "Alert visible",
      "after": "alert fades and lifts out (200 ms), then its height collapses (280 ms inOut)"
    },
    "settleMs": 700,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/27/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-alert-dismiss",
              "selector": {
                "id": "base-alert-dismiss"
              },
              "rect": [0.7692, 0.3152, 0.1128, 0.0521],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
