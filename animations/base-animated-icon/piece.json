{
  "id": "base-animated-icon",
  "title": "Base Animated Icon",
  "component": "BaseAnimatedIcon",
  "family": "base",
  "license": "MIT",
  "files": ["BaseAnimatedIcon.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "verified"
  },
  "tags": ["family-base", "minimal", "icon", "svg"],
  "expoSdk": 58,
  "dependencies": {
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-animated-icon"
    },
    "target": {
      "testID": "base-animated-icon"
    },
    "effect": {
      "before": "Bell at rest",
      "after": "bell swings for 900 ms and its clapper sways for 1100 ms"
    },
    "settleMs": 1200,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/25/2026 (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-animated-icon",
              "selector": {
                "id": "base-animated-icon"
              },
              "rect": [0.0513, 0.2109, 0.4359, 0.1232],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
