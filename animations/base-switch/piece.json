{
  "id": "base-switch",
  "title": "Base Switch",
  "component": "BaseSwitch",
  "family": "base",
  "license": "MIT",
  "files": ["BaseSwitch.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "verified"
  },
  "tags": ["family-base", "minimal", "switch"],
  "expoSdk": 58,
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-switch"
    },
    "target": {
      "testID": "base-switch"
    },
    "effect": {
      "before": "Airplane mode off",
      "after": "thumb stretches, springs to the end and the track turns primary"
    },
    "settleMs": 500,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/25/2026 (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-switch",
              "selector": {
                "id": "base-switch"
              },
              "rect": [0.0513, 0.2109, 0.0821, 0.0218],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  },
  "dependencies": {
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  }
}
