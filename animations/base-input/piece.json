{
  "id": "base-input",
  "title": "Base Input",
  "component": "BaseInput",
  "family": "base",
  "license": "MIT",
  "files": ["BaseInput.tsx", "InputAction.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme", "base-button"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "verified"
  },
  "tags": ["family-base", "minimal", "input"],
  "expoSdk": 57,
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-input"
    },
    "target": {
      "testID": "base-input"
    },
    "effect": {
      "before": "Email field unfocused",
      "after": "border turns ring color and a 3px ring fades in over 200 ms"
    },
    "settleMs": 300,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/25/2026 (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-input",
              "selector": {
                "id": "base-input"
              },
              "rect": [0.1795, 0.3365, 0.7128, 0.0403],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  },
  "dependencies": {
    "lucide-react-native": "^1.61.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  }
}
