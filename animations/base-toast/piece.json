{
  "id": "base-toast",
  "title": "Base Toast",
  "component": "BaseToastProvider",
  "family": "base",
  "license": "MIT",
  "files": ["BaseToast.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme", "base-button"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "toast"],
  "expoSdk": 58,
  "dependencies": {
    "lucide-react-native": "^1.61.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-toast-trigger"
    },
    "target": {
      "testID": "base-toast-trigger"
    },
    "effect": {
      "before": "No toast visible",
      "after": "a toast rises from the bottom edge with spring 280/24 and scale 0.96 to 1"
    },
    "settleMs": 700,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/26/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-toast-trigger",
              "selector": {
                "id": "base-toast-trigger"
              },
              "rect": [0.1051, 0.2855, 0.3779, 0.0427],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
