{
  "id": "base-tab-bar",
  "title": "Base Tab Bar",
  "component": "BaseTabBar",
  "family": "base",
  "license": "MIT",
  "files": ["BaseTabBar.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "tab-bar"],
  "expoSdk": 57,
  "dependencies": {
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-tab-bar-tab-search"
    },
    "target": {
      "testID": "base-tab-bar-tab-search"
    },
    "effect": {
      "before": "Home tab active",
      "after": "pill slides to Search and its label opens with spring 300/30"
    },
    "settleMs": 600,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/26/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-tab-bar-tab-search",
              "selector": {
                "id": "base-tab-bar-tab-search"
              },
              "rect": [0.4043, 0.5391, 0.1128, 0.0569],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
