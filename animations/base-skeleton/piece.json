{
  "id": "base-skeleton",
  "title": "Base Skeleton",
  "component": "BaseSkeleton",
  "family": "base",
  "license": "MIT",
  "files": ["BaseSkeleton.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "skeleton"],
  "expoSdk": 58,
  "dependencies": {
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-skeleton"
    },
    "target": {
      "testID": "base-skeleton"
    },
    "effect": {
      "before": "Profile skeleton pulsing",
      "after": "content replaces the skeleton"
    },
    "settleMs": 400,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/26/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-skeleton",
              "selector": {
                "id": "base-skeleton"
              },
              "rect": [0.1051, 0.2121, 0.1231, 0.0569],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
