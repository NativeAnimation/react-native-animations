{
  "id": "base-tabs",
  "title": "Base Tabs",
  "component": "BaseTabs",
  "family": "base",
  "license": "MIT",
  "files": ["BaseTabs.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "verified"
  },
  "tags": ["family-base", "minimal", "tabs"],
  "expoSdk": 57,
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-tabs-tab-password"
    },
    "target": {
      "testID": "base-tabs-tab-password"
    },
    "effect": {
      "before": "Account tab selected",
      "after": "highlight slides to Password and the Password panel fades in from a 12px shift"
    },
    "settleMs": 600,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/25/2026 (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-tabs-tab-account",
              "selector": {
                "id": "base-tabs-tab-account"
              },
              "rect": [0.059, 0.2145, 0.441, 0.0344],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            },
            {
              "key": "base-tabs-tab-password",
              "selector": {
                "id": "base-tabs-tab-password"
              },
              "rect": [0.5, 0.2145, 0.441, 0.0344],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  },
  "dependencies": {
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
