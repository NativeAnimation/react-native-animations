{
  "id": "base-highlight-text",
  "title": "Base Highlight Text",
  "component": "BaseHighlightText",
  "family": "base",
  "license": "MIT",
  "files": [
    "BaseHighlightText.tsx",
    "index.ts",
    "measureLines.ts",
    "measureLines.web.ts",
    "LICENSE"
  ],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "text", "highlight"],
  "expoSdk": 57,
  "dependencies": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-highlight-text"
    },
    "target": {
      "testID": "base-highlight-text"
    },
    "effect": {
      "before": "Quote text before the sweep",
      "after": "highlight sweeps left to right behind each wrapped line in turn"
    },
    "settleMs": 2500,
    "notes": "The sweep runs on mount (in view); the tap is a no-op, measure from the page load. Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/27/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-highlight-text",
              "selector": {
                "id": "base-highlight-text"
              },
              "rect": [0.1051, 0.2571, 0.7897, 0.1066],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
