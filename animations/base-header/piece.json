{
  "id": "base-header",
  "title": "Base Header",
  "component": "BaseHeader",
  "family": "base",
  "license": "MIT",
  "files": ["BaseHeader.tsx", "BaseHeaderAction.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme", "base-list-row"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "header"],
  "expoSdk": 57,
  "dependencies": {
    "lucide-react-native": "^1.61.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-header-detail-back"
    },
    "target": {
      "testID": "base-header-detail-back"
    },
    "effect": {
      "before": "Detail header with back button",
      "after": "back button scales to 0.97 on press with spring 550/30 and the detail header returns to its parent title"
    },
    "settleMs": 400,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/27/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-header-detail-back",
              "selector": {
                "id": "base-header-detail-back"
              },
              "rect": [0.0744, 0.731, 0.1128, 0.0521],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
