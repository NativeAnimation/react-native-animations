{
  "id": "base-toggle-group",
  "title": "Base Toggle Group",
  "component": "BaseToggleGroup",
  "family": "base",
  "license": "MIT",
  "files": ["BaseToggleGroup.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "toggle", "selection", "chips"],
  "expoSdk": 58,
  "dependencies": {
    "lucide-react-native": "^1.61.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-toggle-group-Italic"
    },
    "target": {
      "testID": "base-toggle-group-Italic"
    },
    "effect": {
      "before": "Italic off",
      "after": "Italic toggles on: press scale 0.97 (spring 550/30) and the pressed fill fades in (200 ms)"
    },
    "settleMs": 500,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/27/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-toggle-group-Italic",
              "selector": {
                "id": "base-toggle-group-Italic"
              },
              "rect": [0.2179, 0.2784, 0.1128, 0.0521],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
