{
  "id": "base-settings-block",
  "title": "Base Settings Block",
  "component": "BaseSettingsBlock",
  "kind": "block",
  "family": "base",
  "license": "MIT",
  "files": ["BaseSettingsBlock.tsx", "BlockLayout.tsx", "index.ts", "LICENSE"],
  "registryDependencies": [
    "base-alert",
    "base-avatar",
    "base-button",
    "base-dialog",
    "base-header",
    "base-list-row",
    "base-select",
    "base-skeleton",
    "base-switch",
    "base-theme",
    "base-toggle-group"
  ],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "screen", "block", "settings"],
  "expoSdk": 58,
  "dependencies": {
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-settings-block-push"
    },
    "target": {
      "testID": "base-settings-block-push"
    },
    "effect": {
      "before": "Push notifications on",
      "after": "switch thumb slides off on its spring and the track color fades"
    },
    "settleMs": 600,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/27/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-settings-block-push",
              "selector": {
                "id": "base-settings-block-push"
              },
              "rect": [0.7462, 0.6291, 0.1128, 0.0521],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
