{
  "id": "base-checkbox",
  "title": "Base Checkbox",
  "component": "BaseCheckbox",
  "family": "base",
  "license": "MIT",
  "files": ["BaseCheckbox.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "verified"
  },
  "tags": ["family-base", "minimal", "checkbox"],
  "expoSdk": 57,
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-checkbox"
    },
    "target": {
      "testID": "base-checkbox"
    },
    "effect": {
      "before": "Second task unchecked",
      "after": "box fills, check draws after 200 ms, task text strikes through"
    },
    "settleMs": 700,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/25/2026 (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-checkbox",
              "selector": {
                "id": "base-checkbox"
              },
              "rect": [0.1051, 0.3258, 0.041, 0.019],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  },
  "dependencies": {
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
