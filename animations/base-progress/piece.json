{
  "id": "base-progress",
  "title": "Base Progress",
  "component": "BaseProgress",
  "family": "base",
  "license": "MIT",
  "files": ["BaseProgress.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "progress"],
  "expoSdk": 57,
  "dependencies": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-progress"
    },
    "target": {
      "testID": "base-progress"
    },
    "effect": {
      "before": "Upload at its current percent",
      "after": "bar springs to the next value with spring 300/35"
    },
    "settleMs": 700,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/26/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-progress",
              "selector": {
                "id": "base-progress"
              },
              "rect": [0.1051, 0.2855, 0.7897, 0.0095],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
