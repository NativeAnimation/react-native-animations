{
  "id": "base-dialog",
  "title": "Base Dialog",
  "component": "BaseDialog",
  "family": "base",
  "license": "MIT",
  "files": ["BaseDialog.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "dialog"],
  "expoSdk": 57,
  "dependencies": {
    "lucide-react-native": "^1.61.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-dialog-open"
    },
    "target": {
      "testID": "base-dialog-open"
    },
    "effect": {
      "before": "Dialog closed",
      "after": "overlay fades in and the dialog flips down from rotateX -20deg and scale 0.8 (spring 150/25)"
    },
    "settleMs": 900,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/26/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-dialog-open",
              "selector": {
                "id": "base-dialog-open"
              },
              "rect": [0.1051, 0.3092, 0.3866, 0.0427],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
