{
  "id": "base-avatar",
  "title": "Base Avatar",
  "component": "BaseAvatar",
  "family": "base",
  "license": "MIT",
  "files": ["BaseAvatar.tsx", "index.ts", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "avatar"],
  "expoSdk": 58,
  "dependencies": {
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "hold",
      "target": "base-avatar-alex"
    },
    "target": {
      "testID": "base-avatar-alex"
    },
    "effect": {
      "before": "Team avatars level",
      "after": "held avatar lifts 30% of its size (spring 300/17) and its name tooltip pops in"
    },
    "settleMs": 700,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/26/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-avatar-alex",
              "selector": {
                "id": "base-avatar-alex"
              },
              "rect": [0.1359, 0.5652, 0.1026, 0.0521],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
