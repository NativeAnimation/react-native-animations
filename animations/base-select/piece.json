{
  "id": "base-select",
  "title": "Base Select",
  "component": "BaseSelect",
  "family": "base",
  "license": "MIT",
  "files": ["BaseSelect.tsx", "index.ts", "AnchoredPanel.tsx", "LICENSE"],
  "registryDependencies": ["base-theme"],
  "platforms": {
    "ios": "unverified",
    "android": "unverified",
    "web": "unverified"
  },
  "tags": ["family-base", "minimal", "select"],
  "expoSdk": 58,
  "dependencies": {
    "lucide-react-native": "^1.61.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "measurement": {
    "schema": 1,
    "gesture": {
      "kind": "tap",
      "target": "base-select-trigger"
    },
    "target": {
      "testID": "base-select-trigger"
    },
    "effect": {
      "before": "Select closed",
      "after": "option list pops from scale 0.8 with spring 400/29 and the chevron turns 180 degrees"
    },
    "settleMs": 500,
    "notes": "Expected geometry at 390x844 with zero host insets, measured in the web demo on 10/26/2026 with scripts/medir-contrato.mjs (not a device observation). Disable autoplay and wait 1 s for fonts before the gesture.",
    "layout": {
      "schema": 1,
      "coordinateSpace": "screen-fractions",
      "checkpoints": [
        {
          "state": "rest",
          "timeMs": 0,
          "elements": [
            {
              "key": "base-select-trigger",
              "selector": {
                "id": "base-select-trigger"
              },
              "rect": [0.1051, 0.3187, 0.7897, 0.0521],
              "tolerance": [0.02, 0.02, 0.02, 0.01],
              "safe": true,
              "interactive": true
            }
          ]
        }
      ]
    }
  }
}
